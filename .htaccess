# Only used when the whole project sits inside the web root (e.g. cPanel public_html).
# Sends every request to Laravel's public/ folder and never serves the project's private files.
# Do NOT add AddHandler/AddType lines here; choose PHP 8.2+ in cPanel > MultiPHP Manager instead.

Options -Indexes

# Block secrets and source files (.env, composer files, logs, etc.)
<FilesMatch "^\.|\.(env|log|sql|zip|lock|md|sh)$|^(artisan|composer\.json|package\.json|vite\.config\.js|phpunit\.xml)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block the project's code folders outright
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]

    # Everything else is served from public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
